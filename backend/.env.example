PORT=5000
MONGODB_URI=mongodb+srv://<username>:<password>@<cluster>.mongodb.net/sqli_sentinel?retryWrites=true&w=majority

# Hugging Face ZeroGPU CodeBERT API (Free Tier Zero-A10G)
HF_SPACE_URL=https://batturekha-sqli-sentinel-codebert.hf.space
# Fine-grained read-only HF token with inference/read permission only (never commit to git or expose to frontend)
HF_TOKEN=hf_your_fine_grained_read_token_here
# 150s+ timeout accommodating container cold-start sleep recovery (~132s)
HF_SPACE_TIMEOUT_MS=150000

# Groq LLM Mode & Resilient Automatic Fallback (Llama 3.3 70B)
GROQ_API_KEY=gsk_your_groq_api_key_here
GROQ_MODEL=llama-3.3-70b-versatile

# Optional local ML service fallback (if running FastAPI service locally)
ML_SERVICE_URL=http://localhost:8000
